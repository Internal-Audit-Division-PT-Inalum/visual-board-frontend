{
  "name": "visual-board-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "biome lint ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts",
    "format": "biome format --write ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts",
    "check": "biome check --write ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "biome check ./src ./e2e ./vite.config.ts ./vitest.config.ts ./playwright.config.ts && npm run typecheck && vitest run && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
