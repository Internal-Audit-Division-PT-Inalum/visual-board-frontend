{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**",
			"vite.config.ts",
			"vitest.config.ts",
			"tsconfig*.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noExplicitAny": "warn",
				"noShadowRestrictedNames": "warn"
			},
			"a11y": {
				"useButtonType": "warn",
				"useSemanticElements": "warn",
				"useKeyWithClickEvents": "warn",
				"noNoninteractiveElementToInteractiveRole": "warn",
				"noStaticElementInteractions": "warn",
				"useValidAriaProps": "warn",
				"noAutofocus": "warn",
				"noLabelWithoutControl": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
